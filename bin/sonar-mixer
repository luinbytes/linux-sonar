class SonarMixerWindow(Adw.ApplicationWindow):
    def __init__(self, app: Adw.Application) -> None:
        super().__init__(application=app)
        self.set_title("Sonar Mixer")
        self.set_default_size(820, 480)
        self.set_resizable(True)

        self._strips: dict[str, ChannelStrip] = {}
        self._sonar_ids: dict[str, int | None] = {}
        self._stream_rows: dict[str, StreamRow] = {}  # keyed by app name

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)

        # Header
        header = Adw.HeaderBar()
        header.add_css_class("flat")
        header.set_title_widget(
            Adw.WindowTitle(title="Sonar Mixer", subtitle="PipeWire Audio Channels")
        )
        refresh_btn = Gtk.Button(icon_name="view-refresh-symbolic")
        refresh_btn.set_tooltip_text("Re-scan PipeWire nodes")
        refresh_btn.connect("clicked", self._on_refresh)
        header.pack_end(refresh_btn)
        root.append(header)

        root.append(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL))

        # ── Main body: strips (left) + routing sidebar (right, resizable) ─
        body = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL)
        body.set_vexpand(True)
        body.set_position(620)   # default: strips get 620px, sidebar gets the rest

        # Channel strips (left pane)
        strips_scroll = Gtk.ScrolledWindow()
        strips_scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.NEVER)
        self._strips_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        self._strips_box.set_halign(Gtk.Align.CENTER)
        self._strips_box.set_hexpand(False)
        self._strips_box.set_valign(Gtk.Align.CENTER)
        strips_scroll.set_child(self._strips_box)
        body.set_start_child(strips_scroll)
        body.set_resize_start_child(True)
        body.set_shrink_start_child(True)

        # ── App routing sidebar (collapsible, right pane) ─────────────────

        routing_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)

        # Header row with collapse toggle
        panel_header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        panel_header.set_margin_top(8)
        panel_header.set_margin_bottom(4)
        panel_header.set_margin_start(8)
        panel_header.set_margin_end(4)

        panel_lbl = Gtk.Label()
        panel_lbl.set_markup('<span foreground="#555555" size="x-small" weight="bold" letter_spacing="1200">ROUTING</span>')
        panel_lbl.set_halign(Gtk.Align.START)
        panel_lbl.set_hexpand(True)
        panel_header.append(panel_lbl)

        self._routing_status = Gtk.Label()
        self._routing_status.set_markup('<span foreground="#555" size="x-small"></span>')
        panel_header.append(self._routing_status)

        self._sidebar_toggle = Gtk.Button()
        self._sidebar_toggle.set_icon_name("pan-end-symbolic")
        self._sidebar_toggle.add_css_class("flat")
        self._sidebar_toggle.set_tooltip_text("Hide routing panel")
        self._sidebar_toggle.connect("clicked", self._on_sidebar_toggle)
        panel_header.append(self._sidebar_toggle)

        routing_box.append(panel_header)

        self._stream_list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self._empty_lbl = Gtk.Label()
        self._empty_lbl.set_markup(
            '<span foreground="#444" size="x-small">—</span>'
        )
        self._empty_lbl.set_margin_top(8)
        self._empty_lbl.set_margin_bottom(8)
        self._empty_lbl.set_halign(Gtk.Align.CENTER)
        self._stream_list.append(self._empty_lbl)

        self._sidebar_revealer = Gtk.Revealer()
        self._sidebar_revealer.set_transition_type(Gtk.RevealerTransitionType.SLIDE_LEFT)
        self._sidebar_revealer.set_reveal_child(True)
        self._sidebar_revealer.set_vexpand(True)

        stream_scroll = Gtk.ScrolledWindow()
        stream_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        stream_scroll.set_vexpand(True)
        stream_scroll.set_child(self._stream_list)
        self._sidebar_revealer.set_child(stream_scroll)
        routing_box.append(self._sidebar_revealer)

        body.set_end_child(routing_box)
        body.set_resize_end_child(False)
        body.set_shrink_end_child(True)
        root.append(body)

        root.append(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL))

        # ── ChatMix ───────────────────────────────────────────────────────
        self._chatmix = ChatMixStrip()
        root.append(self._chatmix)

        root.append(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL))

        self._mic_effects = MicEffectsPanel()
        root.append(self._mic_effects)

        # Wrap everything in a scrolled window so the window never grows past
        # the monitor size — if content overflows, the whole UI scrolls.
        outer_scroll = Gtk.ScrolledWindow()
        outer_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        outer_scroll.set_propagate_natural_height(True)
        outer_scroll.set_child(root)

        self.set_content(outer_scroll)
        self.connect("map", self._on_window_mapped)

        self._populate()
        self._start_hw_chatmix()

        GLib.timeout_add_seconds(5, self._sync_volumes)
        GLib.timeout_add(1500, self._sync_streams)   # 1.5 s — fast enough to win

    # ── Hardware ChatMix wheel ────────────────────────────────────────────

    def _start_hw_chatmix(self) -> None:
        """Start a background thread that reads ChatMix HID events from the headset."""
        t = threading.Thread(target=self._hw_chatmix_loop, daemon=True)
        t.start()

    def _hw_chatmix_loop(self) -> None:
        """Read report 0x45 from Arctis Nova 7 hidraw and push updates to UI."""
        try:
            import hid
        except ImportError:
            return

        VENDOR_ID  = 0x1038
        PRODUCT_ID = 0x22a1
        TARGET_INTERFACE = 5   # usage_page 0xFF00, sends ChatMix reports

        while True:
            try:
                devs = hid.enumerate(VENDOR_ID, PRODUCT_ID)
                target = next((d for d in devs if d['interface_number'] == TARGET_INTERFACE), None)
                if target is None:
                    import time; time.sleep(5); continue

                with hid.Device(path=target['path']) as dev:
                    import time
                    # Read initial wheel position via feature report
                    try:
                        init = dev.get_feature_report(0x45, 64)
                        if init and len(init) >= 3 and init[0] == 0x45:
                            GLib.idle_add(self._chatmix.set_from_hw, init[1], init[2])
                    except Exception:
                        pass

                    dev.nonblocking = True
                    last = None
                    while True:
                        data = dev.read(64)
                        if data and len(data) >= 3 and data[0] == 0x45:
                            game_val = data[1]
                            chat_val = data[2]
                            if (game_val, chat_val) != last:
                                last = (game_val, chat_val)
                                GLib.idle_add(self._chatmix.set_from_hw, game_val, chat_val)
                        time.sleep(0.01)
            except Exception:
                import time; time.sleep(3)

    # ── Populate (full rebuild) ───────────────────────────────────────────

    def _populate(self) -> None:
        while (c := self._strips_box.get_first_child()):
            self._strips_box.remove(c)
        self._strips.clear()

        status = _run(["wpctl", "status"])
        self._sonar_ids = parse_ids(status)

        for i, ch in enumerate(CHANNELS):
            if i > 0:
                sep = Gtk.Separator(orientation=Gtk.Orientation.VERTICAL)
                sep.set_margin_top(12)
                sep.set_margin_bottom(12)
                self._strips_box.append(sep)
            strip = ChannelStrip(ch, self._sonar_ids.get(ch))
            self._strips[ch] = strip
            self._strips_box.append(strip)

        # Thick divider before Mic
        div = Gtk.Separator(orientation=Gtk.Orientation.VERTICAL)
        div.set_margin_top(0)
        div.set_margin_bottom(0)
        div.set_margin_start(6)
        div.set_margin_end(6)
        div.add_css_class("input-divider")
        self._strips_box.append(div)

        mic = ChannelStrip("Mic", self._sonar_ids.get("Mic"))
        self._strips["Mic"] = mic
        self._strips_box.append(mic)

        self._chatmix.set_channel_ids(
            self._sonar_ids.get("Game"),
            self._sonar_ids.get("Chat"),
            game_strip=self._strips.get("Game"),
            chat_strip=self._strips.get("Chat"),
        )

        self._rebuild_streams()

    # ── Stream list ───────────────────────────────────────────────────────

    def _rebuild_streams(self, streams: list | None = None) -> None:
        if streams is None:
            streams = get_active_streams(self._sonar_ids)

        routing_prefs = load_routing_prefs()

        # Group per-stream tuples by app name, preserving first-seen order.
        # groups: app_name → list of (sid, detected_channel, media_role)
        groups: dict[str, list[tuple]] = {}
        for sid, name, detected_channel, media_role in streams:
            groups.setdefault(name, []).append((sid, detected_channel, media_role))

        # Enforce saved preferences only — never override WirePlumber's routing
        # for apps the user has not explicitly configured.
        for name, entries in groups.items():
            if name in routing_prefs:
                preferred = routing_prefs[name]
                for sid, detected_channel, _role in entries:
                    if preferred != detected_channel:
                        move_stream(sid, preferred)

        while (c := self._stream_list.get_first_child()):
            self._stream_list.remove(c)
        self._stream_rows.clear()

        if not groups:
            self._stream_list.append(self._empty_lbl)
            self._routing_status.set_markup('<span foreground="#555" size="x-small"></span>')
            return

        for i, (name, entries) in enumerate(groups.items()):
            if i > 0:
                sep = Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL)
                sep.set_margin_start(14)
                sep.set_margin_end(14)
                sep.set_opacity(0.3)
                self._stream_list.append(sep)

            # Use the channel and role from the first stream in the group.
            first_channel = entries[0][1]
            first_role    = entries[0][2]
            sids = [e[0] for e in entries]

            row = StreamRow(sids, name, first_channel, self._sonar_ids, routing_prefs, first_role)
            self._stream_rows[name] = row
            self._stream_list.append(row)

        n = len(groups)
        self._routing_status.set_markup(
            f'<span foreground="#555" size="x-small">{n} app{"s" if n != 1 else ""}</span>'
        )

    def _sync_streams(self) -> bool:
        streams = get_active_streams(self._sonar_ids)

        # Compare the flat set of all stream IDs currently displayed against
        # what PipeWire reports.  Any appearance or disappearance triggers a
        # full rebuild (which also handles app-name re-grouping).
        displayed_ids: set[int] = set()
        for row in self._stream_rows.values():
            displayed_ids.update(row._stream_ids)
        new_ids = {s[0] for s in streams}

        if displayed_ids != new_ids:
            self._rebuild_streams(streams)
        else:
            # Only enforce routing for apps the user has explicitly configured.
            routing_prefs = load_routing_prefs()
            for sid, name, detected_channel, _media_role in streams:
                if name in routing_prefs:
                    preferred = routing_prefs[name]
                    if preferred != detected_channel:
                        move_stream(sid, preferred)

        return GLib.SOURCE_CONTINUE

    def _sync_volumes(self) -> bool:
        chatmix_centered = self._chatmix.is_centered()
        for name, strip in self._strips.items():
            # Don't overwrite Game/Chat strips from pactl when chatmix is active —
            # pactl holds scaled values, but the strip should show user-intended volume.
            if not chatmix_centered and name in ("Game", "Chat"):
                continue
            strip.refresh()
        return GLib.SOURCE_CONTINUE

    def _on_sidebar_toggle(self, _btn) -> None:
        revealed = self._sidebar_revealer.get_reveal_child()
        self._sidebar_revealer.set_reveal_child(not revealed)
        if revealed:
            self._sidebar_toggle.set_icon_name("pan-start-symbolic")
            self._sidebar_toggle.set_tooltip_text("Show routing panel")
        else:
            self._sidebar_toggle.set_icon_name("pan-end-symbolic")
            self._sidebar_toggle.set_tooltip_text("Hide routing panel")

    def _on_window_mapped(self, _win) -> None:
        """Clamp the window's default size to the current monitor's geometry."""
        try:
            surface = self.get_surface()
            if surface is None:
                return
            display = surface.get_display()
            monitor = display.get_monitor_at_surface(surface)
            if monitor is None:
                return
            geom = monitor.get_geometry()
            # Leave some margin for titlebar/panels
            max_w = max(600, geom.width  - 80)
            max_h = max(400, geom.height - 120)
            cur_w, cur_h = self.get_default_size()
            new_w = min(cur_w if cur_w > 0 else max_w, max_w)
            new_h = min(cur_h if cur_h > 0 else max_h, max_h)
            if (new_w, new_h) != (cur_w, cur_h):
                self.set_default_size(new_w, new_h)
        except Exception as e:
            print(f"[sonar-mixer] monitor clamp failed: {e}", flush=True)

    def _on_refresh(self, _btn) -> None:
        self._chatmix.reset()
        self._populate()


# ---------------------------------------------------------------------------
# CSS
# ---------------------------------------------------------------------------

def _build_css() -> bytes:
    accents = "\n".join(
        f".accent-{n.lower()} {{ background-color: {m['color']}; border-radius: 0; }}"
        for n, m in CHANNEL_META.items()
    )
    # Per-channel colored slider fill — the key visual improvement
    channel_highlights = "\n".join(
        f".channel-{n.lower()} scale.vertical trough highlight"
        f" {{ background-color: {m['color']}; }}"
        for n, m in CHANNEL_META.items()
    )
    dropdown_tints = "\n".join(
        f".ch-{n.lower()} {{ color: {m['color']}; }}"
        for n, m in CHANNEL_META.items()
        if n != "Mic"
    )

    return f"""
    window {{
        background-color: #161616;
    }}

    headerbar.flat {{
        background: transparent;
        border-bottom: 1px solid alpha(white, 0.06);
    }}

    /* ── Channel sliders ── */
    .channel-strip scale.vertical trough {{
        min-width: 2px;
        border-radius: 2px;
        background-color: alpha(white, 0.09);
        margin: 0 8px;
    }}
    .channel-strip scale.vertical trough highlight {{
        border-radius: 2px;
        background-color: alpha(white, 0.3);
    }}
    .channel-strip scale.vertical slider {{
        min-height: 16px;
        min-width: 16px;
        border-radius: 8px;
        background-color: #dedede;
        border: none;
        box-shadow: 0 1px 5px alpha(black, 0.6);
    }}
    .channel-strip scale marks mark indicator {{
        min-height: 0;
        min-width: 0;
        opacity: 0;
    }}

    /* Per-channel fill colors */
    {channel_highlights}

    /* Accent bar */
    {accents}

    /* Volume % */
    .vol-label {{
        font-size: 12px;
        font-family: monospace;
        opacity: 0.85;
        margin-bottom: 2px;
    }}

    /* Mute button */
    .mute-btn {{
        padding: 3px 0;
        border-radius: 4px;
        border: 1px solid alpha(white, 0.1);
        background: transparent;
        opacity: 0.5;
        margin: 0 8px 10px 8px;
        min-height: 0;
    }}
    .mute-btn:hover {{
        opacity: 1;
        background: alpha(white, 0.05);
    }}
    .mute-btn.muted {{
        background-color: alpha(#ef4444, 0.15);
        color: #ef4444;
        border-color: alpha(#ef4444, 0.4);
        opacity: 1;
    }}

    /* Divider between output channels and mic */
    .input-divider {{
        min-width: 1px;
