    }}

    /* ChatMix horizontal slider */
    scale.horizontal trough {{
        min-height: 2px;
        border-radius: 2px;
        background-color: alpha(white, 0.09);
    }}
    scale.horizontal trough highlight {{
        border-radius: 2px;
        background-color: alpha(white, 0.25);
    }}
    scale.horizontal slider {{
        min-height: 14px;
        min-width: 14px;
        border-radius: 7px;
