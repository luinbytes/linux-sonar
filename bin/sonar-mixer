#!/usr/bin/env python3
"""
Sonar Mixer — GTK4/libadwaita PipeWire volume mixer.
Replicates SteelSeries Sonar: channel strips + live app routing panel + ChatMix.

Dependencies (all on Arch):  python  python-gobject  gtk4  libadwaita
"""

import json
import os
import re
import subprocess
import sys
import threading
from pathlib import Path

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, GLib, Gtk


# ---------------------------------------------------------------------------
# PipeWire / pactl helpers
# ---------------------------------------------------------------------------

def _run(cmd: list[str]) -> str:
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=5).stdout
    except Exception:
        return ""


def _pw_dump() -> list[dict]:
    try:
        return json.loads(_run(["pw-dump"]))
    except Exception:
        return []


def parse_ids(status: str) -> dict[str, int | None]:
    """Map channel names → wpctl node IDs by parsing `wpctl status`."""
    ids: dict[str, int | None] = {
        "Game": None, "Chat": None, "Media": None,
        "AUX": None, "VoiceChat": None, "Mic": None,
    }
    for m in re.finditer(
        r"^\s.*?\*?\s+(\d+)\.\s+(Sonar_Game|Sonar_Chat|Sonar_Media|Sonar_AUX|Sonar_VoiceChat)\b",
        status, re.MULTILINE,
    ):
        ids[m.group(2).replace("Sonar_", "")] = int(m.group(1))

    # Mic: search only inside the Sources block
    src_lines, in_audio, in_src = [], False, False
    for line in status.splitlines():
        s = line.strip()
        if s == "Audio":       in_audio = True
        elif s == "Video":     in_audio = False
        if in_audio and "Sources:" in line:  in_src = True
        elif in_src and "Filters:" in line:  break
        if in_src: src_lines.append(line)
    # Prefer our noise-cancelled virtual mic; fall back to physical QuadCast
    m = re.search(r"^\s.*?\*?\s+(\d+)\.\s+Sonar_Mic\b",
                  "\n".join(src_lines), re.MULTILINE)
    if not m:
        m = re.search(r"^\s.*?\*?\s+(\d+)\.\s+HyperX QuadCast",
                      "\n".join(src_lines), re.MULTILINE)
    if m:
        ids["Mic"] = int(m.group(1))
    return ids


def get_volume(node_id: int) -> tuple[float, bool]:
    out = _run(["wpctl", "get-volume", str(node_id)])
    return (
        float(m.group(1)) if (m := re.search(r"Volume:\s+([\d.]+)", out)) else 1.0,
        "[MUTED]" in out,
    )


def set_volume(node_id: int, value: float) -> None:
    _run(["wpctl", "set-volume", str(node_id), f"{max(0.0, min(1.5, value)):.4f}"])


def set_mute(node_id: int, muted: bool) -> None:
    _run(["wpctl", "set-mute", str(node_id), "1" if muted else "0"])


def _get_pactl_input_map() -> dict[int, int]:
    """Returns {pipewire_node_id: pactl_sink_input_index}"""
    out = _run(["pactl", "list", "sink-inputs"])
    result: dict[int, int] = {}
    current_idx: int | None = None
    for line in out.splitlines():
        m = re.match(r'^Sink Input #(\d+)', line.strip())
        if m:
            current_idx = int(m.group(1))
        elif current_idx is not None:
            m2 = re.search(r'object\.id\s*=\s*"(\d+)"', line)
            if m2:
                result[int(m2.group(1))] = current_idx
    return result


def move_stream(node_id: int, channel: str) -> bool:
    """Move a PipeWire output stream to a Sonar channel using pactl."""
    sink_name = f"Sonar_{channel}"
    input_map = _get_pactl_input_map()
    pactl_idx = input_map.get(node_id)
    if pactl_idx is None:
        print(f"[sonar-mixer] node {node_id} not in pactl sink-inputs", file=sys.stderr)
        return False
    r = subprocess.run(["pactl", "move-sink-input", str(pactl_idx), sink_name],
                       capture_output=True, text=True)
    if r.returncode != 0:
        print(f"[sonar-mixer] move {node_id}→{sink_name} failed: {r.stderr.strip()}",
              file=sys.stderr)
    return r.returncode == 0


# ---------------------------------------------------------------------------
# Routing preferences — persists user's app→channel choices
# ---------------------------------------------------------------------------

_PREFS_FILE = Path.home() / ".config" / "sonar-mixer" / "routing.json"


def load_routing_prefs() -> dict[str, str]:
    try:
        return json.loads(_PREFS_FILE.read_text())
    except Exception:
        return {}


def save_routing_pref(app_name: str, channel: str) -> None:
    """
    Persist app→channel preference.
    Routing is enforced via pactl move-sink-input; WirePlumber's state
    restoration then remembers the target for subsequent connections.
    Note: stream.rules update-props with target.object is NOT used because
    it blocks WirePlumber's state restoration without providing routing.
    """
    prefs = load_routing_prefs()
    prefs[app_name] = channel
    _PREFS_FILE.parent.mkdir(parents=True, exist_ok=True)
    _PREFS_FILE.write_text(json.dumps(prefs, indent=2))


def _resolve_app_name(props: dict) -> str:
    """Get a human-readable app name, unwrapping Electron subprocess names."""
    name = props.get("application.name", "")
    binary = props.get("application.process.binary", "")
    pid = props.get("application.process.id")

    if binary in ("electron", "electron40") and pid:
        try:
            with open(f"/proc/{pid}/status") as f:
                for line in f:
                    if line.startswith("PPid:"):
                        ppid = int(line.split()[1])
                        break
            with open(f"/proc/{ppid}/cmdline", "rb") as f:
                cmd = f.read().decode("utf-8", errors="replace").replace("\x00", " ")
            for m in re.finditer(r"/usr/(?:lib|share)/([^/\s]+)", cmd):
                seg = m.group(1)
                if "electron" not in seg.lower():
                    return seg.replace("-", " ").title()
        except Exception:
            pass

    return (name
            or props.get("node.description", "")
            or props.get("media.name", "")
            or props.get("node.name", "")
            or "Unknown")


# ---------------------------------------------------------------------------
# Role-based default channel assignment
# ---------------------------------------------------------------------------

ROLE_DEFAULTS: dict[str, str] = {
    "Music":        "AUX",
    "music":        "AUX",
    "Communication": "Chat",
    "communication": "Chat",
    "Game":         "Game",
    "game":         "Game",
    "Movie":        "Media",
    "Video":        "Media",
    "Notification": "Game",
}


def default_channel(media_role: str | None) -> str:
    return ROLE_DEFAULTS.get(media_role or "", "Game")


def get_active_streams(
        sonar_ids: dict[str, int | None]
) -> list[tuple[int, str, str | None, str | None]]:
    """
    Returns (node_id, app_name, current_channel_or_None, media_role_or_None)
    for every live output stream not owned by EasyEffects or Sonar internals.
    """
    data = _pw_dump()
    if not data:
        return []

    id_to_channel = {v: k for k, v in sonar_ids.items() if v and k != "Mic"}

    # Build client_id → props for native PipeWire apps (Spotify etc.)
    client_props: dict[int, dict] = {
        obj["id"]: obj.get("info", {}).get("props", {})
        for obj in data
        if obj.get("type") == "PipeWire:Interface:Client"
    }

    # Collect all interesting node IDs (EasyEffects nodes we want to skip)
    ee_node_ids: set[int] = {
        obj["id"] for obj in data
        if obj.get("type") == "PipeWire:Interface:Node"
        and "easyeffects" in obj.get("info", {}).get("props", {}).get("node.name", "")
    }

    streams: dict[int, tuple[str, str | None]] = {}
    for obj in data:
        if obj.get("type") != "PipeWire:Interface:Node":
            continue
        if obj["id"] in ee_node_ids:
            continue
        props = obj.get("info", {}).get("props", {})
        if props.get("media.class") != "Stream/Output/Audio":
            continue
        nname = props.get("node.name", "")
        if nname.startswith("Sonar_") or "loopback" in nname.lower():
            continue

        # Merge with Client props if node is missing app-identifying info
        # (native PipeWire apps like Spotify have it only on the Client object)
        merged = dict(props)
        if not props.get("application.name") and not props.get("application.process.binary"):
            cid = props.get("client.id")
            if cid is not None:
                for k, v in client_props.get(cid, {}).items():
                    if not merged.get(k):   # don't overwrite non-empty node values
                        merged[k] = v

        media_role: str | None = merged.get("media.role") or None
        streams[obj["id"]] = (_resolve_app_name(merged), media_role)

    # Determine which Sonar channel each stream is currently linked to
    stream_channel: dict[int, str] = {}
    for obj in data:
        if obj.get("type") != "PipeWire:Interface:Link":
            continue
        info = obj.get("info", {})
        out_id = info.get("output-node-id")
        in_id  = info.get("input-node-id")
        if out_id in streams and in_id in id_to_channel:
            stream_channel[out_id] = id_to_channel[in_id]

    return [
        (sid, name, stream_channel.get(sid), role)
        for sid, (name, role) in sorted(streams.items())
    ]


# ---------------------------------------------------------------------------
# Daemon mode — routing enforcer with no UI
# ---------------------------------------------------------------------------

_CHATMIX_BASE_FILE = Path.home() / ".config" / "sonar-mixer" / "chatmix-base.json"


def _load_chatmix_base() -> tuple[float, float]:
    try:
        data = json.loads(_CHATMIX_BASE_FILE.read_text())
        return float(data.get("game", 1.0)), float(data.get("chat", 1.0))
    except Exception:
        return 1.0, 1.0


def _save_chatmix_base(game: float, chat: float) -> None:
    try:
        _CHATMIX_BASE_FILE.parent.mkdir(parents=True, exist_ok=True)
        _CHATMIX_BASE_FILE.write_text(json.dumps({"game": game, "chat": chat}))
    except Exception:
        pass


def _update_chatmix_base(channel: str, value: float) -> None:
    """Update one channel's base volume. Called when the user moves a strip slider."""
    try:
        data = json.loads(_CHATMIX_BASE_FILE.read_text()) if _CHATMIX_BASE_FILE.exists() else {}
    except Exception:
        data = {}
    data[channel] = value
    _save_chatmix_base(data.get("game", 1.0), data.get("chat", 1.0))


# ---------------------------------------------------------------------------
# Mic effects — SteelSeries Sonar-style processing via dedicated filter-chain
# ---------------------------------------------------------------------------

_MIC_EFFECTS_FILE = Path.home() / ".config" / "sonar-mixer" / "mic-effects.json"
_MIC_CHAIN_CONF   = Path.home() / ".config" / "sonar-mixer" / "mic-filter-chain.conf"

# Available raw mic inputs the filter-chain can pull from. The waybar
# discord-mic swapper toggles between these by calling
#     sonar-mixer --set-mic-input <key>
# which updates _state.mic_input and restarts the subprocess.
_MIC_INPUT_TARGETS: dict[str, str] = {
    "hyperx": "alsa_input.usb-Kingston_HyperX_Quadcast_4110-00.analog-stereo",
    "arctis": "alsa_input.usb-SteelSeries_Arctis_Nova_7-00.mono-fallback",
}
_MIC_INPUT_DEFAULT = "hyperx"


def _get_active_mic_input_key() -> str:
    key = _get_mic_state_key("mic_input", _MIC_INPUT_DEFAULT) or _MIC_INPUT_DEFAULT
    return key if key in _MIC_INPUT_TARGETS else _MIC_INPUT_DEFAULT


def _get_active_mic_input_target() -> str:
    return _MIC_INPUT_TARGETS[_get_active_mic_input_key()]


# Back-compat alias used by the VAD and auto-tune workers (they sample from
# whatever raw mic is currently selected).
_MIC_INPUT_TARGET = _MIC_INPUT_TARGETS[_MIC_INPUT_DEFAULT]

# All mic-related JSON state lives in ONE file: mic-effects.json.
# Effect values live at the top level (rnnoise, gate, eq, etc.).
# Meta-state lives under keys prefixed with "_" (ignored by effect merge):
#   "_state"           — UI state like the active preset name
#   "_custom_presets"  — user-saved named presets


def _read_mic_json() -> dict:
    """Raw read of the unified mic JSON file."""
    try:
        d = json.loads(_MIC_EFFECTS_FILE.read_text())
        return d if isinstance(d, dict) else {}
    except Exception:
        return {}


def _write_mic_json(data: dict) -> None:
    try:
        _MIC_EFFECTS_FILE.parent.mkdir(parents=True, exist_ok=True)
        _MIC_EFFECTS_FILE.write_text(json.dumps(data, indent=2))
    except Exception:
        pass


def _set_mic_state_key(key: str, value) -> None:
    """Update a single meta-state key in mic-effects.json under _state."""
    full = _read_mic_json()
    state = full.get("_state") if isinstance(full.get("_state"), dict) else {}
    state[key] = value
    full["_state"] = state
    _write_mic_json(full)


def _get_mic_state_key(key: str, default=None):
    state = _read_mic_json().get("_state")
    if isinstance(state, dict):
        return state.get(key, default)
    return default


def _set_active_preset(name: str) -> None:
    _set_mic_state_key("active_preset", name)


def _get_active_preset() -> str:
    return _get_mic_state_key("active_preset", "Default") or "Default"

